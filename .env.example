# ============================================================
#  Attendance Pro — Environment Configuration
#  Copy this file to .env and fill in your real values.
# ============================================================

# ---- CockroachDB connection ----
# Local CockroachDB instance (default install):
#   DATABASE_URL=postgresql://root@localhost:26257/attendance_system?sslmode=disable
#
# CockroachDB Serverless / cloud cluster (paste from the CockroachDB Console,
# and make sure the database "attendance_system" exists or is created by db/init.js):
#   DATABASE_URL=postgresql://user:password@host:26257/attendance_system?sslmode=verify-full
#
# >>> PASTE YOUR COCKROACHDB CONNECTION STRING BELOW <<<
DATABASE_URL=postgresql://root@localhost:26257/attendance_system?sslmode=disable

# Set to true when connecting to a cloud / Serverless cluster (enables TLS for the driver)
DB_SSL=false

# ---- Web server ----
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Default admin (used by: npm run seed) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@attendance.local
ADMIN_PASSWORD=Admin@1234
